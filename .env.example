# =========================================================================
# 무기고(Arsenal) 에이전트 시스템 환경 설정 템플릿
# =========================================================================
# 이 파일을 복사하여 '.env' 파일로 이름을 변경한 뒤, 필요한 API 키를 입력하세요.
# 주의: 실제 '.env' 파일은 절대 GitHub 등 원격 저장소에 푸시하면 안 됩니다.

# 1. LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. System Configurations (옵션)
# 에이전트 캐시 및 프롬프트 라우팅을 위한 활성화 스위치
MODEL_ROUTING_ENABLED=true
AGENT_DEBUG_MODE=false

# 3. Notification Services (옵션)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
